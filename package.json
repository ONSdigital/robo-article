{
	"name": "@onsvisual/robo-article",
	"homepage": "http://onsdigital.github.io/robo-article",
	"version": "0.1.0",
	"scripts": {
		"dev": "vite dev --mode preview",
		"build": "vite build && node ./scripts/js-fix && node ./scripts/gen-sitemap",
		"build:preview": "cross-env PUBLIC_APP_ENV=preview vite build",
		"build:data": "node ./scripts/build-data",
		"check:data": "node ./scripts/check-data",
		"preview": "vite preview",
		"lint": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check .",
		"format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write ."
	},
	"author": "Ahmad Barclay",
	"license": "MIT",
	"devDependencies": {
		"@onsvisual/robo-utils": "^0.6.5",
		"@onsvisual/svelte-charts": "^0.4.11",
		"@onsvisual/svelte-components": "^2.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@zumer/snapdom": "^3.7.2",
		"cross-env": "^7.0.3",
		"d3-dsv": "latest",
		"d3-format": "^3.1.0",
		"node-html-parser": "^6.1.5",
		"parse-color": "^1.0.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"pug": "^3.0.4",
		"svelte": "^5.57.1",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"sirv-cli": "^1.0.0"
	},
	"type": "module"
}
